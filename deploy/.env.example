# ===========================================
# RSVP & Wishes - Production Environment
# ===========================================

# Domain Configuration
DOMAIN=rsvp.yourdomain.com

# Admin Dashboard API URL (should match your domain)
ADMIN_API_URL=https://rsvp.yourdomain.com/api

# CORS Origins (comma-separated)
# Include: Canva domains, your domain, admin app
CORS_ORIGINS=https://rsvp.yourdomain.com,https://*.canva-apps.com,https://*.canva.site

# Admin Password (CHANGE THIS!)
ADMIN_PASSWORD=your-secure-password-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SSL Email for Let's Encrypt notifications
SSL_EMAIL=your-email@example.com
