# ===========================================
# Production Environment Configuration
# ===========================================

# Server port (Cloudflare Tunnel connects to this)
PORT=80

# Domain (your Cloudflare domain)
DOMAIN=rsvp.yourdomain.com

# Backend URL for Canva app
CANVA_BACKEND_HOST=https://rsvp.yourdomain.com

# Admin API URL (relative path works since same domain)
ADMIN_API_URL=/api

# CORS Origins
CORS_ORIGINS=https://rsvp.yourdomain.com,https://*.canva-apps.com,https://*.canva.site

# Admin Password (CHANGE THIS!)
ADMIN_PASSWORD=your-secure-password-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
